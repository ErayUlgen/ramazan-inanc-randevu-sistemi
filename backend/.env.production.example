NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://CHANGE_USER:CHANGE_PASSWORD@CHANGE_HOST:5432/ramazan_inanc_booking?schema=public
REQUEST_BODY_LIMIT=256kb

FRONTEND_URL=https://randevu.example.com
PUBLIC_APP_URL=https://randevu.example.com
ALLOW_INSECURE_PRODUCTION_URLS=false

ADMIN_API_KEY=
ALLOW_ADMIN_API_KEY_HEADER=false
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CUSTOMER_SESSION_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
CUSTOMER_AUTH_OTP_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
BOOKING_ACCESS_SESSION_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
BOOKING_ACCESS_OTP_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
ACTION_TOKEN_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS

SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
NETGSM_OTP_URL=https://api.netgsm.com.tr/sms/send/otp
NETGSM_SMS_URL=https://api.netgsm.com.tr/sms/send/xml
SMS_WEBHOOK_SECRET=

DISABLE_NOTIFICATION_WORKERS=false
ALLOW_PRODUCTION_SEED=false
ALLOW_DATABASE_RESTORE=false
